@baseUrl = http://localhost:5385
@guid = 11111111-1111-1111-1111-111111111111
@guid2 = 22222222-2222-2222-2222-222222222222

### People CRUD
GET {{baseUrl}}/api/people
Accept: application/json

###
GET {{baseUrl}}/api/people/{{guid}}
Accept: application/json

###
POST {{baseUrl}}/api/people
Content-Type: application/json

{
  "fullName": "Ada Lovelace",
  "email": "ada@example.com",
  "department": "Engineering",
  "location": "Paris",
  "isActive": true,
  "organizationId": null,
  "externalId": "USR0001",
  "createdBy": "api"
}

###
PUT {{baseUrl}}/api/people/{{guid}}
Content-Type: application/json

{
  "fullName": "Ada Byron",
  "email": "ada@example.com",
  "department": "Engineering",
  "location": "Paris",
  "isActive": true,
  "organizationId": null,
  "externalId": "USR0001",
  "createdBy": "api"
}

###
DELETE {{baseUrl}}/api/people/{{guid}}

