<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <EnableDefaultItems>False</EnableDefaultItems>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <RootNamespace>ITSM.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITSM.ServiceDefaults\ITSM.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ITSM.Web.Client\ITSM.Web.Client.csproj" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
        <PackageReference Include="DevExtreme.AspNet.Data" Version="5.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
	    <PackageReference Include="DevExpress.Blazor" Version="26.1.4" />
	    <PackageReference Include="DevExpress.AIIntegration" Version="26.1.4" />
	    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.4" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="**\*.cs" Exclude="obj\**\*.cs" />
        <Content Include="Components\**\*.razor" />
        <Content Include="Components\**\*.css" />
        <Content Include="wwwroot\**\*.*" />
        <Content Include="*.json" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
	
</Project>
