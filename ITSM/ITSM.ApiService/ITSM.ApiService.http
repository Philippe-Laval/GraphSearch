{
  "agentId": "{{guid}}",
  "assignmentGroupId": "{{guid2}}",
  "assignedAt": "2026-09-17T08:00:00+00:00",
  "removedAt": null,
  "roleInGroup": "Escalation"
}

###
DELETE {{baseUrl}}/api/agent-group-memberships/{{guid}}/{{guid2}}

