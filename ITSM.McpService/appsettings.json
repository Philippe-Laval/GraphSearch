{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AzureAd": {
    "Audience": "<client-id-of-your-WEB-app-registration>",
    "Issuer": "https://login.microsoftonline.com/<your-tenant-id>/v2.0",
    "Authority": "https://login.microsoftonline.com/<your-tenant-id>"
  },

  "McpServer": {
    "Url": "https://<your-web-app-url>/mcp",
    "AzureAd": {
      "ClientId": "<client-id-of-your-MCP-app-registration>"
    }
  }

}
